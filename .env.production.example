# Copy this file to .env.production and replace every REPLACE_ME value.
# Store the completed file in AWS Systems Manager Parameter Store. Never commit it.

POSTGRES_USER=praxis
POSTGRES_DB=praxis
POSTGRES_PASSWORD=REPLACE_ME_URL_SAFE_DATABASE_PASSWORD

PRAXIS_API_KEY=REPLACE_ME_RANDOM_API_KEY
PRAXIS_JWT_SECRET=REPLACE_ME_RANDOM_JWT_SECRET
PRAXIS_BOOTSTRAP_ADMIN_EMAIL=admin@inferia.ai
PRAXIS_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_ME_STRONG_ADMIN_PASSWORD
PRAXIS_INTEGRATION_ENCRYPTION_KEY=REPLACE_ME_FERNET_KEY

PRAXIS_LLM_MODEL=llama3.1:8b
PRAXIS_LLM_NUM_CTX=8192
PRAXIS_LLM_REQUEST_TIMEOUT=300
PRAXIS_COPILOT_PROVIDER=ollama
PRAXIS_COPILOT_MODEL=
PRAXIS_COPILOT_BASE_URL=https://router-api.0g.ai/v1
ZEROG_COMPUTE_API_KEY=
PRAXIS_COPILOT_REQUEST_TIMEOUT=25
PRAXIS_COPILOT_NUM_CTX=4096
PRAXIS_COPILOT_NUM_PREDICT=384

CLOUDFLARE_TUNNEL_TOKEN=
VITE_ENABLE_SSO=false

# Optional production integrations
PRAXIS_SMTP_HOST=
PRAXIS_SMTP_PORT=587
PRAXIS_SMTP_USERNAME=
PRAXIS_SMTP_PASSWORD=
PRAXIS_SMTP_FROM=
PRAXIS_SLACK_WEBHOOK_URL=
PRAXIS_JIRA_BASE_URL=
PRAXIS_JIRA_EMAIL=
PRAXIS_JIRA_API_TOKEN=
PRAXIS_DRIVE_OAUTH_CLIENT_ID=
PRAXIS_DRIVE_OAUTH_CLIENT_SECRET=
PRAXIS_DRIVE_OAUTH_REDIRECT_URI=https://praxis.inferia.ai/api/integrations/drive/callback
PRAXIS_DOCUSIGN_INTEGRATION_KEY=
PRAXIS_DOCUSIGN_USER_ID=
PRAXIS_DOCUSIGN_PRIVATE_KEY=
PRAXIS_DOCUSIGN_ACCOUNT_ID=
