# PRAXIS - environment configuration
# Copy to .env and adjust. All values have sane local defaults in config.py.

# --- LLM (Ollama, on-prem) ---
PRAXIS_LLM_PROVIDER=ollama
PRAXIS_OLLAMA_HOST=http://localhost:11434
PRAXIS_LLM_MODEL=llama3.1:8b
PRAXIS_LLM_TEMPERATURE=0.0
PRAXIS_LLM_NUM_CTX=8192
PRAXIS_LLM_REQUEST_TIMEOUT=300

# Copilot uses Ollama by default. Set provider to 0g and add a funded Router key to use 0G.
PRAXIS_COPILOT_PROVIDER=ollama
PRAXIS_COPILOT_MODEL=
PRAXIS_COPILOT_BASE_URL=https://router-api.0g.ai/v1
ZEROG_COMPUTE_API_KEY=
PRAXIS_COPILOT_REQUEST_TIMEOUT=25
PRAXIS_COPILOT_NUM_CTX=4096
PRAXIS_COPILOT_NUM_PREDICT=256

# --- Embeddings ---
PRAXIS_EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2

# --- Vector store (ChromaDB) ---
# Leave CHROMA_HOST empty to use an embedded/persistent local client (dev/CLI).
# Set host+port to use the chromadb container (docker compose).
PRAXIS_CHROMA_HOST=
PRAXIS_CHROMA_PORT=8000
PRAXIS_CHROMA_PATH=./data/chroma

# --- Relational DB ---
# Local default (config.py) is a SQLite file so the CLI/tests run with zero setup.
# Docker compose overrides this to the postgres service. For no-Docker dev, point
# at a local postgres or a sqlite URL (SQLAlchemy handles both transparently).
PRAXIS_DATABASE_URL=postgresql+psycopg2://praxis:praxis@localhost:5432/praxis

# --- Redis Streams ---
PRAXIS_REDIS_URL=redis://localhost:6379/0
PRAXIS_REDIS_STREAM=praxis:document.process
PRAXIS_REDIS_GROUP=praxis-workers

# --- Storage ---
PRAXIS_DOC_STORE_PATH=./data/documents
PRAXIS_CORPUS_PATH=./data/corpus
PRAXIS_ORG_CONFIG_PATH=./data/org_config.json
PRAXIS_EXPORT_PATH=./data/exports

# --- Pipeline thresholds (proposal §6, §7) ---
PRAXIS_PARSE_QUALITY_MIN=0.70
PRAXIS_OCR_TRIGGER_QUALITY=0.80
PRAXIS_OBLIGATION_CONFIDENCE_MIN=0.65

# --- API Authentication ---
# Set to a strong secret for production. Leave empty for local dev (no auth enforced).
PRAXIS_API_KEY=

# JWT signing for auth tokens and the SSO state cookie. CHANGE THIS in production -
# the default "change-me-in-production" is only safe for local dev.
PRAXIS_JWT_SECRET=change-me-in-production
PRAXIS_JWT_ALGORITHM=HS256
PRAXIS_JWT_EXPIRE_MINUTES=1440
PRAXIS_BOOTSTRAP_ADMIN_EMAIL=admin@praxis.local
PRAXIS_BOOTSTRAP_ADMIN_PASSWORD=admin123

# --- Audit ---
PRAXIS_AUDIT_RETENTION_DAYS=2555

# --- Integrations (Tier 1-3) ---
# See docs/setup-and-run.md -> "Integrations" for what to provide per integration.

# Credential encryption at rest. Leave empty to auto-generate a key persisted to
# data/integration.key; set a fixed value to keep it stable across restarts.
PRAXIS_INTEGRATION_ENCRYPTION_KEY=

# SSO (OIDC / Keycloak) - the demo realm ships pre-configured in docker-compose and
# the defaults below "just work". Only change these for a custom realm / IdP.
PRAXIS_FRONTEND_URL=http://localhost:5173
PRAXIS_SSO_REDIRECT_URI=http://localhost:8080/api/auth/sso/callback
PRAXIS_KEYCLOAK_URL=http://localhost:8081
PRAXIS_KEYCLOAK_REALM=praxis
PRAXIS_KEYCLOAK_CLIENT_ID=praxis-web
PRAXIS_KEYCLOAK_CLIENT_SECRET=praxis-demo-secret

# Google Drive (Tier 2) - OAuth client from a Google Cloud test project. These are
# defaults; credentials entered in the Settings UI (stored encrypted) take precedence.
# Create: console.cloud.google.com -> OAuth consent screen (Testing mode) -> Client ID/Secret
# with authorized redirect URI = http://localhost:8080/api/integrations/drive/callback
PRAXIS_DRIVE_OAUTH_CLIENT_ID=
PRAXIS_DRIVE_OAUTH_CLIENT_SECRET=
PRAXIS_DRIVE_OAUTH_REDIRECT_URI=http://localhost:8080/api/integrations/drive/callback

# DocuSign (Tier 2) - developer sandbox JWT grant. Also defaults; UI credentials win.
# Create: developers.docusign.com -> free sandbox account -> Integration key, User ID,
# Account ID, and the RSA private key (PEM) bound to that integration key.
PRAXIS_DOCUSIGN_INTEGRATION_KEY=
PRAXIS_DOCUSIGN_USER_ID=
PRAXIS_DOCUSIGN_PRIVATE_KEY=
PRAXIS_DOCUSIGN_ACCOUNT_ID=
